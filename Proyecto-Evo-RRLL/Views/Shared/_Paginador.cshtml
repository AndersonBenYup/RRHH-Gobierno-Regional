@model Proyecto_Evo_RRLL.Models.ViewModels.PaginadorModelo
@using Proyecto_Evo_RRLL.Models.ViewModels
@*
    SC-005: paginador reutilizable para las tablas paginadas en el servidor.
    Uso: <partial name="_Paginador" model="new PaginadorModelo(pagina, totalPaginas, total, "Index", filtros, tamano, "empleados")" />
    Las tablas que se paginan en el navegador (site.js) generan este mismo HTML con las mismas clases.
    En el celular solo quedan "Anterior", la página actual y "Siguiente".
*@
@{
    var id = "pag" + Guid.NewGuid().ToString("N")[..8];
}
<div class="evo-paginador">
    <p class="evo-paginador-resumen">
        @if (Model.Total == 0)
        {
            <span>No hay @Model.Etiqueta para mostrar</span>
        }
        else
        {
            <span>Mostrando <b>@PaginadorModelo.Numero(Model.Desde)–@PaginadorModelo.Numero(Model.Hasta)</b> de <b>@PaginadorModelo.Numero(Model.Total)</b> @Model.Etiqueta</span>
        }
    </p>

    <div class="evo-paginador-controles">
        <form method="get" asp-action="@Model.Accion" class="evo-paginador-tamano">
            @foreach (var filtro in Model.Filtros)
            {
                <input type="hidden" name="@filtro.Key" value="@filtro.Value" />
            }
            <label for="@(id)-tamano">Filas por página</label>
            <select id="@(id)-tamano" name="tamano" class="form-select form-select-sm" data-autoenviar>
                @foreach (var t in PaginadorModelo.TamanosPermitidos)
                {
                    <option value="@t" selected="@(t == Model.TamanoPagina)">@t</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary evo-solo-sin-js">Aplicar</button>
        </form>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación">
                <ul class="pagination">
                    <li class="page-item evo-pag-extremo @(Model.HayAnterior ? null : "disabled")">
                        @if (Model.HayAnterior)
                        {
                            <a class="page-link" rel="prev" asp-action="@Model.Accion" asp-all-route-data="Model.RutaPara(Model.Pagina - 1)">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-disabled="true"><i class="bi bi-chevron-left" aria-hidden="true"></i><span>Anterior</span></span>
                        }
                    </li>
                    @foreach (var p in Model.Ventana())
                    {
                        if (p == 0)
                        {
                            <li class="page-item evo-pag-elipsis" aria-hidden="true"><span class="page-link">…</span></li>
                        }
                        else if (p == Model.Pagina)
                        {
                            <li class="page-item active evo-pag-actual" aria-current="page">
                                <span class="page-link"><span class="visually-hidden">Página </span>@PaginadorModelo.Numero(p)<span class="evo-pag-de"> de @PaginadorModelo.Numero(Model.TotalPaginas)</span></span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item evo-pag-num">
                                <a class="page-link" asp-action="@Model.Accion" asp-all-route-data="Model.RutaPara(p)" aria-label="Página @p">@PaginadorModelo.Numero(p)</a>
                            </li>
                        }
                    }
                    <li class="page-item evo-pag-extremo @(Model.HaySiguiente ? null : "disabled")">
                        @if (Model.HaySiguiente)
                        {
                            <a class="page-link" rel="next" asp-action="@Model.Accion" asp-all-route-data="Model.RutaPara(Model.Pagina + 1)">
                                <span>Siguiente</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-disabled="true"><span>Siguiente</span><i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                        }
                    </li>
                </ul>
            </nav>

            <form method="get" asp-action="@Model.Accion" class="evo-paginador-ir">
                @foreach (var filtro in Model.Filtros)
                {
                    <input type="hidden" name="@filtro.Key" value="@filtro.Value" />
                }
                <input type="hidden" name="tamano" value="@Model.TamanoPagina" />
                <label for="@(id)-ir">Ir a página</label>
                <input id="@(id)-ir" type="number" name="pagina" class="form-control form-control-sm" min="1" max="@Model.TotalPaginas" inputmode="numeric" required />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Ir</button>
            </form>
        }
    </div>
</div>
