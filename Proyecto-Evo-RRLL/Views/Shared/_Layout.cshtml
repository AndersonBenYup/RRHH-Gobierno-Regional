<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RRHH</title>
    @* SC-011: aplica el tema guardado antes de pintar (evita el destello claro en modo oscuro) y marca que hay JavaScript. *@
    <script>
        (function () {
            var r = document.documentElement, t = null;
            r.classList.add('js');
            try { t = localStorage.getItem('evo-theme'); } catch (e) { }
            if (!t && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
            if (t) r.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* SC-011: sistema visual institucional (Tailwind, compilado desde Estilos/app.css) *@
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "con-dock" : "")" data-url-buscar-documento="@(User.Identity?.IsAuthenticated == true ? Url.Action("PorDocumento", "BuscarEmpleado") : null)">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <div id="splashLoader" class="splash-loader">
        <div class="splash-box">
            <span class="brand-logo splash-logo"><i class="bi bi-person-badge-fill"></i></span>
            <div class="splash-title">RRHH</div>
            <div class="splash-bar"><span></span></div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var nombreUsuario = User.Identity?.Name ?? "";
        var partesNombre = nombreUsuario.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        string inicialesUsuario;
        if (partesNombre.Length >= 2)
            inicialesUsuario = (partesNombre[0].Substring(0, 1) + partesNombre[1].Substring(0, 1)).ToUpper();
        else if (partesNombre.Length == 1)
            inicialesUsuario = (partesNombre[0].Length >= 2 ? partesNombre[0].Substring(0, 2) : partesNombre[0].Substring(0, 1)).ToUpper();
        else
            inicialesUsuario = "?";

        <header class="topbar">
            <div class="d-flex align-items-center gap-3 w-100">
                <a class="topbar-brand" asp-controller="Home" asp-action="Index" aria-label="RRHH, ir al inicio">
                    <span class="brand-logo"><i class="bi bi-person-badge-fill" aria-hidden="true"></i></span>
                    <span class="fw-bold d-none d-sm-inline">RRHH</span>
                </a>
                <span class="topbar-separador d-none d-md-block" aria-hidden="true"></span>
                <div class="flex-grow-1 d-none d-md-block page-title text-truncate">@ViewData["Title"]</div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <form class="d-flex me-2 d-none d-lg-inline-flex" role="search" onsubmit="return false;">
                        <div class="input-group search-box">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input id="siteSearch" type="search" class="form-control" placeholder="Buscar en esta página..." aria-label="Buscar en esta página" />
                        </div>
                    </form>
                    <button id="themeToggle" class="icon-btn" type="button" aria-label="Cambiar tema" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Cambiar tema">
                        <i id="themeIcon" class="bi bi-moon-stars"></i>
                    </button>
                    <div class="dropdown">
                        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mi cuenta">
                            <span class="user-avatar">@inicialesUsuario</span>
                            <span class="d-none d-sm-inline">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <form asp-controller="Seguridad" asp-action="CerrarSesion" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>
        <partial name="_DockNavegacion" />
    }
    else
    {
        <nav class="navbar navbar-dark bg-primary shadow-sm auth-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo"><i class="bi bi-person-badge-fill"></i></span>
                    RRHH
                </a>
                <button id="themeToggle" class="btn btn-outline-light btn-sm" type="button" aria-label="Cambiar tema">
                    <i id="themeIcon" class="bi bi-moon-stars"></i>
                </button>
            </div>
        </nav>
    }

    <main id="contenido" role="main" class="main-content @(User.Identity?.IsAuthenticated == true ? "" : "no-topbar")">
        <div class="container-fluid py-4 px-3 px-md-4">
            @if (User.Identity?.IsAuthenticated == true && ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
            {
                <nav aria-label="breadcrumb" class="breadcrumb-bar">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            }
            @if (TempData["MensajeExito"] is string exito)
            {
                <div class="alert alert-success alert-dismissible fade show alert-auto shadow-sm" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@exito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["MensajeError"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show alert-auto shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <partial name="_PestanasModulo" />
            }
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span class="small">RRHH &copy; @DateTime.Now.Year</span>
            <span class="d-flex gap-3 small">
                <a asp-controller="Home" asp-action="Ayuda" class="link-body-emphasis text-decoration-none">
                    <i class="bi bi-question-circle me-1"></i>Ayuda
                </a>
                <a asp-controller="Home" asp-action="Privacidad" class="link-body-emphasis text-decoration-none">
                    <i class="bi bi-shield-lock me-1"></i>Política de privacidad
                </a>
            </span>
            <span class="small">Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </footer>

    <div class="evo-toasts" id="toastHost" aria-live="polite"></div>

    @* Ventana emergente para Nuevo/Editar: site.js carga aquí el formulario de los enlaces con data-modal-form.
       Sin JavaScript el enlace abre la página completa, como antes. *@
    <div class="modal fade evo-modal-form" id="modalForm" tabindex="-1" aria-labelledby="modalFormTitulo" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="modalFormTitulo">Formulario</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalFormCuerpo"></div>
            </div>
        </div>
    </div>

    <div id="cookieBanner" class="cookie-banner bg-body-tertiary shadow-lg" role="region" aria-label="Aviso de cookies">
        <div class="container py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <p class="mb-0 small"><i class="bi bi-cookie me-1"></i>Este sitio utiliza cookies para recordar tus preferencias (tema oscuro) y sesión. Al continuar navegando aceptas su uso.</p>
            <button id="cookieAccept" type="button" class="btn btn-primary btn-sm">Aceptar</button>
        </div>
    </div>

    <button id="backToTop" type="button" class="btn btn-primary back-to-top" aria-label="Volver arriba">
        <i class="bi bi-arrow-up"></i>
    </button>

    <div id="loadingSpinner" class="loading-spinner" aria-hidden="true">
        <div class="spinner-border text-light" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>