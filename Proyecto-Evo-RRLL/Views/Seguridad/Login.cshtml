@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}
@* SC-011: inicio de sesión institucional. Panel de marca a la izquierda (solo en pantallas anchas) y formulario a la derecha. *@
<div class="tw-mx-auto tw-grid tw-w-full tw-max-w-5xl tw-overflow-hidden tw-rounded-lg tw-border tw-border-solid tw-border-piedra-300 tw-bg-white tw-shadow-sm md:tw-grid-cols-[1.05fr_1fr] dark:tw-border-[#27333A] dark:tw-bg-[#161E21]">
    <aside class="acceso-panel tw-hidden tw-flex-col tw-justify-between tw-gap-10 tw-p-10 tw-text-white md:tw-flex">
        <div class="tw-flex tw-items-center tw-gap-3">
            <span class="tw-inline-flex tw-h-10 tw-w-10 tw-items-center tw-justify-center tw-rounded-md tw-bg-white tw-text-lg tw-text-petroleo-800" aria-hidden="true">
                <i class="bi bi-person-badge-fill"></i>
            </span>
            <div class="tw-leading-tight">
                <div class="tw-text-sm tw-font-semibold">Gobierno Regional</div>
                <div class="tw-text-xs tw-text-petroleo-200">Oficina de Recursos Humanos</div>
            </div>
        </div>

        <div>
            <h1 class="tw-m-0 tw-text-[2rem] tw-font-semibold tw-leading-tight tw-tracking-tight tw-text-white">Sistema de Gestión<br />de Recursos Humanos</h1>
            <p class="tw-mb-0 tw-mt-4 tw-max-w-[38ch] tw-text-[0.98rem] tw-leading-relaxed tw-text-petroleo-100">
                Ficha del personal, asistencia, permisos, capacitación, salud y vivienda en un solo lugar.
            </p>
        </div>

        <ul class="tw-m-0 tw-grid tw-list-none tw-grid-cols-2 tw-gap-x-6 tw-gap-y-3 tw-p-0 tw-text-sm tw-text-petroleo-100">
            <li class="tw-flex tw-items-center tw-gap-2"><i class="bi bi-people tw-text-[#E8C48A]" aria-hidden="true"></i>Fichas por empleado</li>
            <li class="tw-flex tw-items-center tw-gap-2"><i class="bi bi-clock-history tw-text-[#E8C48A]" aria-hidden="true"></i>Asistencia diaria</li>
            <li class="tw-flex tw-items-center tw-gap-2"><i class="bi bi-calendar-check tw-text-[#E8C48A]" aria-hidden="true"></i>Permisos y feriados</li>
            <li class="tw-flex tw-items-center tw-gap-2"><i class="bi bi-shield-check tw-text-[#E8C48A]" aria-hidden="true"></i>Roles y bitácora</li>
        </ul>
    </aside>

    <section class="tw-flex tw-flex-col tw-justify-center tw-px-6 tw-py-10 sm:tw-px-12">
        <div class="tw-mb-8">
            <div class="tw-mb-6 tw-flex tw-items-center tw-gap-2 md:tw-hidden">
                <span class="tw-inline-flex tw-h-9 tw-w-9 tw-items-center tw-justify-center tw-rounded-md tw-bg-petroleo-800 tw-text-white" aria-hidden="true"><i class="bi bi-person-badge-fill"></i></span>
                <span class="tw-text-sm tw-font-semibold">Recursos Humanos</span>
            </div>
            <h2 class="tw-m-0 tw-text-2xl tw-font-semibold">Iniciar sesión</h2>
            <p class="tw-mb-0 tw-mt-1 tw-text-sm tw-text-piedra-600 dark:tw-text-[#9BA6AB]">Ingrese con su usuario del sistema.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger tw-flex tw-gap-2 tw-py-2 tw-text-sm" role="alert">
                <i class="bi bi-exclamation-triangle tw-mt-0.5" aria-hidden="true"></i><span>@Model.Error</span>
            </div>
        }

        <form asp-action="Login" method="post" novalidate class="@(string.IsNullOrEmpty(Model.Error) ? null : "acceso-sacudida")">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger tw-mb-3 tw-text-sm"></div>

            <div class="tw-mb-4">
                <label asp-for="Login" class="form-label">Usuario</label>
                <input asp-for="Login" class="form-control tw-py-2" autofocus autocomplete="username" />
                <span asp-validation-for="Login" class="text-danger small"></span>
            </div>
            <div class="tw-mb-6">
                <label asp-for="Clave" class="form-label">Clave</label>
                <div class="input-group">
                    <input asp-for="Clave" class="form-control tw-py-2" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Clave" aria-label="Mostrar u ocultar la clave">Mostrar</button>
                </div>
                <span asp-validation-for="Clave" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary tw-w-full tw-py-2" data-cargando="Entrando…">Entrar</button>
        </form>

        <p class="tw-mb-0 tw-mt-8 tw-text-sm tw-text-piedra-600 dark:tw-text-[#9BA6AB]">
            ¿Olvidó su clave o su cuenta está bloqueada? Pida al administrador del sistema que la restablezca.
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
