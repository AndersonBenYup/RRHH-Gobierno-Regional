@model Capa_Logica.VacacionesEmpleado?
@{
    ViewData["Title"] = "Detalle de vacaciones";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-0">Vacaciones</h3>
        <span class="text-secondary small">@ViewBag.NombreEmpleado</span>
    </div>
    <a asp-action="Index" asp-route-corte="@ViewBag.Corte" class="btn btn-outline-secondary">Volver al reporte</a>
</div>

@if (Model is null)
{
    <div class="alert alert-info">El empleado no tiene fecha de ingreso registrada en su periodo laboral; no se pueden calcular sus vacaciones.</div>
}
else
{
    <partial name="_SaldoVacaciones" model="Model" />
}
