@model RRHH_Asegurado
@{
    ViewData["Title"] = "Beneficiario";
    var esNuevo = Model.NroBeneficiario == 0;
    var empleados = ViewBag.Empleados as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var personas = ViewBag.Personas as List<(int Id, string Nombre)> ?? new List<(int, string)>();
    var vinculos = ViewBag.Vinculos as List<VinculoAsegurado> ?? new List<VinculoAsegurado>();
    var motivos = ViewBag.MotivosBaja as List<MotivoBaja> ?? new List<MotivoBaja>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(esNuevo ? "Nuevo beneficiario" : $"Editar beneficiario #{Model.NroBeneficiario}")</h3>
    <a asp-action="Asegurados" asp-route-idEmpleado="@Model.idEmpleado" class="btn btn-outline-secondary">Volver</a>
</div>

<form asp-action="@(esNuevo ? "AseguradoNuevo" : "AseguradoEditar")" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors-wrap"></div>
    <div class="card">
        <div class="card-body">
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="idEmpleado" />
                <input type="hidden" asp-for="NroBeneficiario" />
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Empleado</label>
                    <select asp-for="idEmpleado" class="form-select">
                        <option value="">(seleccionar)</option>
                        @foreach (var e in empleados)
                        {
                            <option value="@e.Id">@e.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="idEmpleado" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Familiar / beneficiario *</label>
                    <select asp-for="idPersona" class="form-select" required>
                        <option value="">(seleccionar persona)</option>
                        @foreach (var p in personas)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="idPersona" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Vínculo familiar</label>
                    <select asp-for="IdVinculoAsegurado" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var v in vinculos)
                        {
                            <option value="@v.IdVinculoAsegurado">@v.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="IdVinculoAsegurado" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° partida</label>
                    <input asp-for="NroPartida" class="form-control" />
                    <span asp-validation-for="NroPartida" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">N° resol. mayor incap.</label>
                    <input asp-for="NroResolMayorIndiscap" class="form-control" />
                    <span asp-validation-for="NroResolMayorIndiscap" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Reevaluar</label>
                    <input asp-for="Reevaluar" class="form-control" />
                    <span asp-validation-for="Reevaluar" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha inicio vínculo</label>
                    <input asp-for="FechaInicioVinculo" type="date" class="form-control" />
                    <span asp-validation-for="FechaInicioVinculo" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Motivo de baja</label>
                    <select asp-for="idMotivoBaja" class="form-select">
                        <option value="">(sin asignar)</option>
                        @foreach (var m in motivos)
                        {
                            <option value="@m.idMotivoBaja">@m.Descripcion</option>
                        }
                    </select>
                    <span asp-validation-for="idMotivoBaja" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">N° partida defunción</label>
                    <input asp-for="NroPartidaDef" class="form-control" />
                    <span asp-validation-for="NroPartidaDef" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Otros motivos</label>
                    <input asp-for="OtrosMotivos" class="form-control" />
                    <span asp-validation-for="OtrosMotivos" class="text-danger small d-block"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha fin vínculo</label>
                    <input asp-for="FechaFinVinculo" type="date" class="form-control" />
                    <span asp-validation-for="FechaFinVinculo" class="text-danger small d-block"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}